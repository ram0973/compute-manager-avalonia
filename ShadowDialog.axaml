<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ComputerManager.ShadowDialog"
        Title="Shadow RDP" Width="580" Height="420" MinWidth="460" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="13">

    <DockPanel Margin="16">
        <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,10" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="RefreshButton" Content="⟳ Обновить" Click="OnRefreshClick" />
            <Button Content="👁 Подключиться" Click="OnConnectClick" IsDefault="True" />
            <Button Content="Закрыть" Click="OnCloseClick" IsCancel="True" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,10,0,0">
            <CheckBox x:Name="ControlCheck" Content="Управление (иначе только просмотр)" IsChecked="True" />
            <CheckBox x:Name="NoConsentCheck" Content="Не запрашивать согласие пользователя (если разрешено политикой)" />
            <TextBlock x:Name="StatusText" Opacity="0.8" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>

        <DataGrid x:Name="SessionsGrid"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource LineBrush}"
                  DoubleTapped="OnSessionDoubleTapped">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto" MinWidth="50" />
                <DataGridTextColumn Header="Пользователь" Binding="{Binding UserName}" Width="Auto" MinWidth="150" />
                <DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="Auto" MinWidth="110" />
                <DataGridTextColumn Header="Сеанс" Binding="{Binding SessionName}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
